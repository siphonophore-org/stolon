<Project>

  <!--
    Builds a plugin's translations in. Imported by Siphonophore.Stolon.targets.
      * Localization/*.json are the plugin's own strings, one file per language, with en-us.json holding every key.
      * Localization/casing.json is the plugin's casing list, the words title case and sentence case keep as written.
      * <JellyfinString Include="Key" /> declares a Jellyfin string the plugin uses. Source="web" or "server" picks
        one source when both have the key. The web client's is used otherwise. Case="title" or "sentence" converts
        its English text.
      * <JellyfinTextMatch Include="Key" /> lets the plugin's own key keep English that Jellyfin also says, when the
        meaning differs.
    The StolonBuildTranslations task checks both against Jellyfin's strings, then embeds one JSON file per language as
    Stolon.Translations.<language>.json, with Stolon's own strings from strings/ in every plugin, read by
    StolonTranslations. It embeds the casing list as Stolon.Casing.json, read by TextCase, and compiles the
    TranslationKeys class when the plugin has strings of its own.
  -->
  <PropertyGroup>
    <StolonLocalizationDirectory Condition="'$(StolonLocalizationDirectory)' == ''">Localization\</StolonLocalizationDirectory>
    <StolonJellyfinStringsDirectory Condition="'$(StolonJellyfinStringsDirectory)' == ''">$(MSBuildThisFileDirectory)..\jellyfin\</StolonJellyfinStringsDirectory>
    <StolonStringsDirectory Condition="'$(StolonStringsDirectory)' == ''">$(MSBuildThisFileDirectory)..\strings\</StolonStringsDirectory>
    <StolonTasksAssembly Condition="'$(StolonTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tasks\net10.0\Siphonophore.Stolon.Tasks.dll</StolonTasksAssembly>
    <StolonGenerateTranslationKeys Condition="'$(StolonGenerateTranslationKeys)' == ''">true</StolonGenerateTranslationKeys>
    <StolonTranslationKeysNamespace Condition="'$(StolonTranslationKeysNamespace)' == ''">Siphonophore.Stolon</StolonTranslationKeysNamespace>
    <StolonTranslationKeysClass Condition="'$(StolonTranslationKeysClass)' == ''">TranslationKeys</StolonTranslationKeysClass>
    <_BaseTaskHostable Condition="'$(MSBuildRuntimeType)' == 'Core' Or $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">true</_BaseTaskHostable>
  </PropertyGroup>

  <!-- The task targets .NET. Visual Studio's MSBuild runs it in a .NET task host. -->
  <UsingTask TaskName="Siphonophore.Stolon.Tasks.StolonBuildTranslations" AssemblyFile="$(StolonTasksAssembly)" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Siphonophore.Stolon.Tasks.StolonBuildTranslations" AssemblyFile="$(StolonTasksAssembly)" TaskFactory="TaskHostFactory" Runtime="NET" Condition="'$(MSBuildRuntimeType)' != 'Core' And '$(_BaseTaskHostable)' == 'true'" />

  <Target Name="StolonTranslations" BeforeTargets="PrepareResources;CoreCompile" DependsOnTargets="_BasePrepareTranslations;_BaseRunTranslations;_BaseIncludeTranslations" />

  <Target Name="_BasePrepareTranslations">
    <PropertyGroup>
      <StolonCasingFile Condition="'$(StolonCasingFile)' == '' And Exists('$(StolonLocalizationDirectory)casing.json')">$(StolonLocalizationDirectory)casing.json</StolonCasingFile>
    </PropertyGroup>

    <ItemGroup>
      <StolonLocalString Include="$(StolonLocalizationDirectory)*.json" Exclude="$(StolonLocalizationDirectory)casing.json" Condition="'@(StolonLocalString)' == ''" />
      <_BaseStringFile Include="$(StolonStringsDirectory)*.json" />
      <!-- The plugin's own files are built in merged with Jellyfin's, so a copy embedded as is would only add size. -->
      <EmbeddedResource Remove="@(StolonLocalString);$(StolonCasingFile)" />
    </ItemGroup>

    <!-- Set here rather than at the top, since IntermediateOutputPath is only known once the SDK targets load. -->
    <PropertyGroup>
      <StolonTranslationsOutput Condition="'$(StolonTranslationsOutput)' == ''">$(IntermediateOutputPath)stolon-translations\</StolonTranslationsOutput>
      <_BaseTranslationsOwn Condition="'@(StolonLocalString)' != '' Or '@(JellyfinString)' != '' Or '$(StolonCasingFile)' != ''">true</_BaseTranslationsOwn>
      <!-- Stolon's own strings are built into every plugin. Where MSBuild cannot run the task, a plugin with no strings of
           its own builds without them, and Stolon's text stays US English. -->
      <_BaseTranslationsActive Condition="'$(StolonTranslations)' != 'false' And ('$(_BaseTaskHostable)' == 'true' Or '$(_BaseTranslationsOwn)' == 'true')">true</_BaseTranslationsActive>
      <_BaseTranslationsSettings>$(StolonTranslationsOutput)settings.txt</_BaseTranslationsSettings>
      <_BaseTranslationsStamp>$(StolonTranslationsOutput)built.stamp</_BaseTranslationsStamp>
      <_BaseTranslationsLanguages>$(StolonTranslationsOutput)languages\</_BaseTranslationsLanguages>
      <_BaseTranslationsCasing>$(StolonTranslationsOutput)casing.json</_BaseTranslationsCasing>
      <_BaseTranslationKeysFile Condition="'$(StolonGenerateTranslationKeys)' == 'true' And ('@(StolonLocalString)' != '' Or '@(JellyfinString)' != '')">$(StolonTranslationsOutput)$(StolonTranslationKeysClass).g.cs</_BaseTranslationKeysFile>
    </PropertyGroup>

    <Error Condition="'$(_BaseTranslationsActive)' == 'true' And '$(_BaseTaskHostable)' != 'true'" Code="STOL016" Text="Translations build with the .NET SDK. Run dotnet build, or use Visual Studio 2026 or later." />

    <!-- Every setting the output depends on, written only when it changes, so a changed item rebuilds the strings. -->
    <WriteLinesToFile Condition="'$(_BaseTranslationsActive)' == 'true'"
                      File="$(_BaseTranslationsSettings)"
                      Lines="@(JellyfinString->'string:%(Identity)|%(Source)|%(Case)');@(JellyfinTextMatch->'match:%(Identity)');@(StolonLocalString->'file:%(FullPath)');casing:$(StolonCasingFile);keys:$(StolonGenerateTranslationKeys)|$(StolonTranslationKeysNamespace)|$(StolonTranslationKeysClass)|$(_BaseTranslationKeysFile)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="_BaseRunTranslations"
          Condition="'$(_BaseTranslationsActive)' == 'true'"
          Inputs="@(StolonLocalString);$(StolonCasingFile);@(_BaseStringFile);$(_BaseTranslationsSettings);$(StolonJellyfinStringsDirectory)source.json;$(StolonTasksAssembly)"
          Outputs="$(_BaseTranslationsStamp);$(_BaseTranslationsCasing);$(_BaseTranslationKeysFile)">
    <StolonBuildTranslations LocalFiles="@(StolonLocalString)"
                          JellyfinStrings="@(JellyfinString)"
                          TextMatches="@(JellyfinTextMatch)"
                          SnapshotDirectory="$(StolonJellyfinStringsDirectory)"
                          StolonStringsDirectory="$(StolonStringsDirectory)"
                          CasingFile="$(StolonCasingFile)"
                          CasingOutput="$(_BaseTranslationsCasing)"
                          OutputDirectory="$(_BaseTranslationsLanguages)"
                          KeysFile="$(_BaseTranslationKeysFile)"
                          KeysNamespace="$(StolonTranslationKeysNamespace)"
                          KeysClass="$(StolonTranslationKeysClass)"
                          ProjectFile="$(MSBuildProjectFullPath)" />
    <Touch Files="$(_BaseTranslationsStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="_BaseIncludeTranslations" Condition="'$(_BaseTranslationsActive)' == 'true'">
    <ItemGroup>
      <_BaseTranslationFile Include="$(_BaseTranslationsLanguages)*.json" />
      <EmbeddedResource Include="@(_BaseTranslationFile)" LogicalName="Stolon.Translations.%(Filename).json" WithCulture="false" Type="Non-Resx" />
      <EmbeddedResource Include="$(_BaseTranslationsCasing)" LogicalName="Stolon.Casing.json" WithCulture="false" Type="Non-Resx" />
      <Compile Include="$(_BaseTranslationKeysFile)" Condition="'$(_BaseTranslationKeysFile)' != ''" />
      <FileWrites Include="@(_BaseTranslationFile);$(_BaseTranslationKeysFile);$(_BaseTranslationsCasing);$(_BaseTranslationsStamp);$(_BaseTranslationsSettings)" />
    </ItemGroup>
  </Target>

</Project>
